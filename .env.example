# ---------------------------------------------------------------------------
# Rig Valley server configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Postgres connection. Leave empty to use embedded PGlite (development only).
# DATABASE_URL=postgres://rigvalley:rigvalley@localhost:5432/rigvalley
PGLITE_DIR=.data/pglite

# Browser origins allowed to call the API, and what players sign in for (SIWE).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SESSION_DAYS=14
COOKIE_SECURE=false

# Admin panel bearer token (min 16 chars). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# --- Robinhood Chain --------------------------------------------------------
# VERIFY every value below against official Robinhood Chain docs before use.
# Testnet (as of 2026-10): chain id 46630, https://rpc.testnet.chain.robinhood.com
# Mainnet: chain id 4663, https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=46630
CHAIN_NAME=Robinhood Chain Testnet
RPC_URL=
# RPC handed to browsers for self-submitted claims (defaults to RPC_URL). Never expose a keyed RPC.
PUBLIC_RPC_URL=
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# NVDA Stock Token — take the address ONLY from Robinhood's official contract list.
NVDA_TOKEN_ADDRESS=
NVDA_DECIMALS=18
NVDA_SYMBOL=NVDA
# RigValleyDistributor deployed with contracts/script/Deploy.s.sol
DISTRIBUTOR_ADDRESS=
# Voucher-signing key (cannot move funds). Its address is set as voucherSigner on the contract.
VOUCHER_SIGNER_KEY=
# Optional gas sponsorship: this key only ever calls claim() on the distributor. Keep it funded with a little ETH.
RELAYER_PRIVATE_KEY=
VOUCHER_TTL_SECONDS=1800

# --- NVDA price feed ---------------------------------------------------------
# static | http | chainlink   (VERIFY which feed is available on Robinhood Chain)
PRICE_FEED=static
NVDA_USD_PRICE=180
# PRICE_HTTP_URL=https://example.com/price/nvda
# PRICE_HTTP_PATH=data.price
# CHAINLINK_FEED_ADDRESS=
PRICE_MAX_AGE_SECONDS=86400

# Optional: POST {text} here when the distribution contract balance runs low.
# ALERT_WEBHOOK_URL=
